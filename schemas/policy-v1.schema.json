{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE pak risk policy v1",
  "description": "Structural schema. PolicyYaml also enforces YAML lexical rules, resource limits, unique rule IDs, homogeneous literal sets, and canonical DNS hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "rules"],
  "properties": {
    "schema-version": { "const": 1 },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 4096 },
    "ownerPath": { "type": "string", "pattern": "^/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*(?:\\.[A-Za-z0-9_]+)+$", "maxLength": 4096 },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "effect", "match"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "description": { "$ref": "#/$defs/text" },
        "effect": { "enum": ["flag", "forbid"] },
        "match": { "$ref": "#/$defs/expression" }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "expressions"],
          "properties": {
            "kind": { "enum": ["all", "any"] },
            "expressions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "expression"],
          "properties": { "kind": { "const": "not" }, "expression": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": { "kind": { "const": "invocation" }, "target": { "$ref": "#/$defs/target" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "name", "predicate"],
          "properties": {
            "kind": { "const": "argument" }, "name": { "$ref": "#/$defs/identifier" },
            "predicate": { "$ref": "#/$defs/predicate" }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "owner", "function"],
          "properties": {
            "kind": { "const": "exact" }, "owner": { "$ref": "#/$defs/ownerPath" },
            "function": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": { "kind": { "const": "owner" }, "owner": { "$ref": "#/$defs/ownerPath" } }
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "equals" }, "value": { "$ref": "#/$defs/literal" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "in" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/literal" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "prefix"],
          "properties": { "kind": { "const": "string-starts-with" }, "prefix": { "$ref": "#/$defs/text" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "hosts"],
          "properties": {
            "kind": { "const": "url-host-in" },
            "hosts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$" }
            }
          }
        }
      ]
    },
    "literal": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "string" }, "value": { "type": "string", "maxLength": 4096 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": { "kind": { "const": "null" } }
        }
      ]
    }
  }
}
