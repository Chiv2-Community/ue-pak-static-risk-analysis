{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE pak risk policy v1",
  "description": "Structural schema. PolicyYaml also enforces YAML 1.2 core scalar inference, finite numeric values, resource limits, unique rule IDs and canonical DNS hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "rules"],
  "properties": {
    "schema-version": { "const": 1 },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 4096 },
    "ownerPath": { "type": "string", "pattern": "^/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*(?:\\.[A-Za-z0-9_]+)+$", "maxLength": 4096 },
    "nameSelector": { "oneOf": [
      { "$ref": "#/$defs/identifier" },
      { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "$ref": "#/$defs/identifier" } } }
    ] },
    "ownerSelector": { "oneOf": [
      { "$ref": "#/$defs/ownerPath" }, { "const": "__WILDCARD__" },
      { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "$ref": "#/$defs/ownerPath" } } }
    ] },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "effect", "expression"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "description": { "$ref": "#/$defs/text" },
        "effect": { "enum": ["flag", "forbid"] },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["invocation"],
          "properties": { "invocation": { "$ref": "#/$defs/invocation" } }
        },
        { "$ref": "#/$defs/argumentExpression" },
        {
          "type": "object", "additionalProperties": false, "required": ["property-write"],
          "properties": { "property-write": {
            "type": "object", "additionalProperties": false, "required": ["class", "property"],
            "properties": {
              "class": { "$ref": "#/$defs/ownerSelector" },
              "property": { "oneOf": [
                { "$ref": "#/$defs/propertyPath" },
                { "type": "object", "additionalProperties": false, "required": ["literal"],
                  "properties": { "literal": { "$ref": "#/$defs/propertyPath" } } }
              ] },
              "predicate": { "$ref": "#/$defs/predicate" }
            }
          } }
        }
      ]
    },
    "argumentExpression": {
      "type": "object", "additionalProperties": false,
      "required": ["argument"],
      "properties": {
        "argument": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "predicate"],
          "properties": {
            "name": { "$ref": "#/$defs/nameSelector" },
            "predicate": { "$ref": "#/$defs/predicate" }
          }
        }
      }
    },
    "propertyPath": { "type": "string", "maxLength": 4096, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
    "invocation": {
      "oneOf": [
        {
          "type": "string", "maxLength": 4096,
          "pattern": "^(?:__WILDCARD__|/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*(?:\\.[A-Za-z0-9_]+)+)(?::[A-Za-z_][A-Za-z0-9_]*)?$"
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["class"],
          "dependentRequired": { "args": ["function"] },
          "properties": {
            "class": { "$ref": "#/$defs/ownerSelector" },
            "function": { "$ref": "#/$defs/nameSelector" },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/argumentExpression" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": {
              "type": "string", "maxLength": 4096,
              "pattern": "^(?:__WILDCARD__|/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*(?:\\.[A-Za-z0-9_]+)+):[A-Za-z_][A-Za-z0-9_]*$"
            },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/argumentExpression" } }
          }
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "subexpr"],
          "properties": { "kind": { "const": "subexpr-match" }, "subexpr": { "$ref": "#/$defs/expression" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "equals" }, "value": { "$ref": "#/$defs/literal" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "in" },
            "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/literal" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": { "kind": { "const": "regex-match" }, "pattern": { "$ref": "#/$defs/text" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "hosts"],
          "properties": {
            "kind": { "const": "url-host-in" },
            "hosts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$" }
            }
          }
        }
      ]
    },
    "literal": {
      "oneOf": [
        { "type": "string", "maxLength": 4096 },
        { "type": ["number", "boolean", "null"] },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "const": "wildcard" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "value"],
          "properties": { "kind": { "const": "number" }, "value": { "type": "number" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "string" }, "value": { "type": "string", "maxLength": 4096 } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "integer" },
            "value": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "boolean" }, "value": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"], "properties": { "kind": { "const": "null" } }
        }
      ]
    }
  }
}
