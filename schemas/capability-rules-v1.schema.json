{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private capability rules v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema-version", "disclosure", "revision", "rules"],
  "properties": {
    "schema-version": {"const": 1}, "disclosure": {"const": "private"},
    "revision": {"$ref": "#/$defs/id"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "capability", "effect", "caller"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "capability": {"$ref": "#/$defs/id"}, "effect": {"enum": ["flag", "forbid"]},
        "caller": {"oneOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["owner", "function", "max-depth"],
          "properties": {
            "owner": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/[A-Za-z0-9_]+(?:/[A-Za-z0-9_]+)*(?:\\.[A-Za-z0-9_]+)+$"},
            "function": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "max-depth": {"type": "integer", "minimum": 1, "maximum": 16}
          }
        }]}
      }
    }}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"}}
}
