{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chiv2-Community/ue-pak-static-risk-analysis/schemas/report-v1.schema.json",
  "title": "Risk evaluation report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema-version", "status", "analysis-complete", "context", "counts", "coverage", "flagged-invocations", "forbidden-invocations", "diagnostics"],
  "properties": {
    "schema-version": {"const": 1},
    "status": {"enum": ["successful", "partial", "failed"]},
    "analysis-complete": {"type": "boolean"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["tool-version", "engine-version", "pak-sha256", "producer-version", "dependencies"],
      "properties": {
        "tool-version": {"type": "string"},
        "engine-version": {"const": "4.25"},
        "pak-sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "producer-version": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["kind", "sha256"],
          "properties": {"kind": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
        }},
        "policy-revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._\\-]+$"},
        "capability-catalog-revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._\\-]+$"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["invocations", "flagged", "forbidden", "affected-union"],
      "properties": {"invocations": {"$ref": "#/$defs/count"}, "flagged": {"$ref": "#/$defs/count"}, "forbidden": {"$ref": "#/$defs/count"}, "affected-union": {"$ref": "#/$defs/count"}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["gaps", "evaluation-incomplete"],
      "properties": {
        "gaps": {"type": "array", "uniqueItems": true, "maxItems": 3, "items": {"enum": ["unsupported-parsing", "unresolved-dispatch", "incomplete-extraction"]}},
        "evaluation-incomplete": {"type": "boolean"}
      }
    },
    "flagged-invocations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/finding"}},
    "forbidden-invocations": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/finding"}},
    "diagnostics": {"type": "array", "maxItems": 1, "items": {"enum": ["invalid-configuration", "analysis-failed", "parser-failed", "parser-output-limit", "wall-timeout", "cancelled", "container-unavailable", "input-failed"]}},
    "inspection": {"$ref": "facts-v1.schema.json#/$defs/inspection"},
    "call-chains": {"$ref": "#/$defs/call-chains"},
    "data-analysis": {"$ref": "#/$defs/data-analysis"},
    "capability-analysis": {"$ref": "#/$defs/capability-analysis"},
    "property-writes": {
      "type": "object", "additionalProperties": false, "required": ["observed", "flagged", "forbidden"],
      "properties": {
        "observed": {"$ref": "#/$defs/count"},
        "flagged": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/property-write"}},
        "forbidden": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/property-write"}}
      }
    },
    "possible-dispatches": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "possibly-flagged", "possibly-forbidden"],
      "properties": {"evidence": {"$ref": "facts-v1.schema.json#/$defs/dispatch"},
        "possibly-flagged": {"type": "boolean"}, "possibly-forbidden": {"type": "boolean"}}
    }},
    "content-policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema-version", "decision", "incomplete", "findings"],
      "properties": {
        "schema-version": {"const": 1},
        "decision": {"enum": ["allow", "needs-review", "reject"]},
        "incomplete": {"type": "boolean"},
        "findings": {"type": "array", "maxItems": 50000, "items": {
          "type": "object", "additionalProperties": false, "required": ["member-id", "diagnostic"],
          "properties": {
            "member-id": {"$ref": "facts-v1.schema.json#/$defs/identity"},
            "diagnostic": {"enum": ["path-identity-unavailable", "path-not-allowed", "protected-path-candidate", "content-inspection-unavailable", "class-inspection-unavailable", "class-not-allowed", "inventory-unavailable"]}
          }
        }}
      }
    }
  },
  "allOf": [
    {"if": {"required": ["capability-analysis"]}, "then": {"allOf": [
      {"if": {"properties": {"capability-analysis": {"properties": {"complete": {"const": false}}}}},
       "then": {"properties": {"analysis-complete": {"const": false}}}},
      {"if": {"not": {"$ref": "#/$defs/complete-capability-evidence"}},
       "then": {"properties": {"capability-analysis": {"$ref": "#/$defs/incomplete-capability-evidence"}}}},
      {"if": {"$ref": "#/$defs/complete-capability-evidence"}, "then": {"properties": {"capability-analysis": {
        "properties": {"diagnostics": {"not": {"contains": {"const": "capability-evidence-incomplete"}}},
          "possibly-flagged": {"const": false}, "possibly-forbidden": {"const": false}}
      }}}}
    ]}},
    {"if": {"properties": {"status": {"const": "successful"}}}, "then": {"properties": {"analysis-complete": {"const": true}, "diagnostics": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["partial", "failed"]}}}, "then": {"properties": {"analysis-complete": {"const": false}}}},
    {"if": {"properties": {"status": {"const": "partial"}}}, "then": {"properties": {"diagnostics": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"diagnostics": {"minItems": 1}, "flagged-invocations": {"maxItems": 0}, "forbidden-invocations": {"maxItems": 0}}}}
  ],
  "$defs": {
    "property-write": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "location", "opcode", "owner", "property", "receiver"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "location": {"$ref": "facts-v1.schema.json#/$defs/location"},
        "opcode": {"$ref": "facts-v1.schema.json#/$defs/write-opcode"},
        "owner": {"$ref": "facts-v1.schema.json#/$defs/write-owner"},
        "property": {"$ref": "facts-v1.schema.json#/$defs/write-path"},
        "receiver": {"enum": ["self", "object", "unknown"]},
        "rule-ids": {"type": "array", "minItems": 1, "maxItems": 8192, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
      }
    },
    "complete-capability-evidence": {
      "required": ["call-chains"], "properties": {"call-chains": {
        "required": ["complete", "catalog-sha256", "diagnostics"],
        "properties": {"complete": {"const": true}, "catalog-sha256": {"type": "string"}, "diagnostics": {"maxItems": 0}}
      }}
    },
    "possible-capability-effect": {
      "anyOf": [{"properties": {"possibly-flagged": {"const": true}}},
                {"properties": {"possibly-forbidden": {"const": true}}}]
    },
    "incomplete-capability-evidence": {
      "allOf": [{"$ref": "#/$defs/possible-capability-effect"}],
      "properties": {"complete": {"const": false}, "decision": {"enum": ["needs-review", "reject"]},
        "diagnostics": {"contains": {"const": "capability-evidence-incomplete"}}}
    },
    "capability-analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["schema-version", "complete", "decision", "findings", "possibly-flagged", "possibly-forbidden", "diagnostics"],
      "properties": {
        "schema-version": {"const": 1}, "complete": {"type": "boolean"},
        "decision": {"enum": ["no-match", "needs-review", "reject"]},
        "possibly-flagged": {"type": "boolean"}, "possibly-forbidden": {"type": "boolean"},
        "diagnostics": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["capability-evidence-incomplete", "capability-match-uncertain"]}},
        "findings": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["witness", "flagged", "forbidden", "possibly-flagged", "possibly-forbidden"],
          "properties": {"witness": {"type": "integer", "minimum": 0, "maximum": 255},
            "flagged": {"type": "boolean"}, "forbidden": {"type": "boolean"},
            "possibly-flagged": {"type": "boolean"}, "possibly-forbidden": {"type": "boolean"}}
        }}
      },
      "allOf": [
        {"if": {"properties": {"diagnostics": {"maxItems": 0}}}, "then": {"properties": {"complete": {"const": true}}}},
        {"if": {"properties": {"diagnostics": {"minItems": 1}}}, "then": {"properties": {"complete": {"const": false}}}},
        {"if": {"properties": {"decision": {"const": "no-match"}}}, "then": {"properties": {
          "complete": {"const": true}, "findings": {"maxItems": 0}, "possibly-flagged": {"const": false}, "possibly-forbidden": {"const": false}
        }}},
        {"if": {"properties": {"diagnostics": {"contains": {"const": "capability-evidence-incomplete"}}}},
         "then": {"$ref": "#/$defs/incomplete-capability-evidence"}}
      ]
    },
    "data-analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["schema-version", "decision", "complete", "findings", "diagnostics"],
      "properties": {
        "schema-version": {"const": 1}, "decision": {"enum": ["no-match", "needs-review", "reject"]}, "complete": {"type": "boolean"},
        "diagnostics": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["data-baseline-unavailable", "data-evidence-incomplete", "data-baseline-incomplete", "data-property-unavailable", "data-comparison-unavailable"]}},
        "findings": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {
          "type": "object", "additionalProperties": false, "required": ["member-id", "export-index", "property-ordinal", "reason", "action"],
          "properties": {
            "member-id": {"$ref": "facts-v1.schema.json#/$defs/identity"},
            "export-index": {"type": "integer", "minimum": 1, "maximum": 4096},
            "property-ordinal": {"type": "integer", "minimum": 0, "maximum": 4095},
            "reason": {"enum": ["reviewed-serialized-property-changed", "reviewed-serialized-assertion-matched"]},
            "action": {"enum": ["review", "reject"]}
          }
        }}
      }
    },
    "chain-target": {
      "type": "object", "additionalProperties": false, "required": ["owner", "function"],
      "properties": {"owner": {"type": "string", "maxLength": 4096}, "function": {"type": "string", "maxLength": 4096}}
    },
    "call-chains": {
      "type": "object", "additionalProperties": false,
      "required": ["schema-version", "complete", "needs-review", "catalog-revision", "catalog-sha256", "witnesses", "diagnostics"],
      "properties": {
        "schema-version": {"const": 1}, "complete": {"type": "boolean"}, "needs-review": {"type": "boolean"},
        "catalog-revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._\\-]+$"},
        "catalog-sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "diagnostics": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": [
          "graph-context-unavailable", "graph-context-incomplete", "extraction-incomplete", "indirect-open-world", "native-summary-unavailable", "graph-work-limit", "source-identity-unavailable", "external-summary-unavailable", "target-identity-ambiguous", "graph-edge-limit", "target-unresolved", "witness-limit", "evidence-byte-limit", "witness-depth-limit"
        ]}},
        "witnesses": {"type": "array", "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["endpoint", "resolution", "callers"],
          "properties": {
            "resolution": {"enum": ["direct", "possible"]},
            "endpoint": {
              "type": "object", "additionalProperties": false, "required": ["origin", "target", "resolution", "flagged", "forbidden", "capability"],
              "properties": {
                "origin": {"$ref": "facts-v1.schema.json#/$defs/location"}, "target": {"$ref": "#/$defs/chain-target"},
                "resolution": {"enum": ["direct", "possible"]}, "flagged": {"type": "boolean"}, "forbidden": {"type": "boolean"},
                "capability": {"type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._\\-]+$"}
              }
            },
            "callers": {"type": "array", "maxItems": 16, "items": {
              "type": "object", "additionalProperties": false, "required": ["origin", "target", "resolution", "kind"],
              "properties": {
                "origin": {"$ref": "facts-v1.schema.json#/$defs/location"}, "target": {"$ref": "#/$defs/chain-target"},
                "resolution": {"enum": ["direct", "possible"]}, "kind": {"enum": ["invocation", "virtual", "delegate-binding", "delegate-mutation", "multicast", "timer"]}
              }
            }}
          }
        }}
      }
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "location", "target", "argument-metadata", "known-argument-count"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "location": {
          "type": "object", "additionalProperties": false, "required": ["asset", "function", "offset"],
          "properties": {"asset": {"type": "string", "maxLength": 4096}, "function": {"type": "string", "maxLength": 4096}, "offset": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}}
        },
        "target": {"oneOf": [
          {"type": "null"},
          {"type": "object", "additionalProperties": false, "required": ["owner", "function"], "properties": {"owner": {"type": "string", "maxLength": 4096}, "function": {"type": "string", "maxLength": 4096}}}
        ]},
        "argument-metadata": {"enum": ["known", "unavailable"]},
        "known-argument-count": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
        "rule-ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
      }
    }
  }
}
