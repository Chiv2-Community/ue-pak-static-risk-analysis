{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private operator-reviewed serialized-data policy v1",
  "description": "Structural contract; DataPolicy also validates typed known literals, uniqueness, Unicode, bounds and identical build contexts. No authenticity or safety claim.",
  "type": "object", "additionalProperties": false,
  "required": ["schema-version", "disclosure", "context", "baseline", "rules"],
  "properties": {
    "schema-version": {"const": 1}, "disclosure": {"const": "private"}, "context": {"$ref": "#/$defs/context"},
    "baseline": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["pak-sha256", "context"],
      "properties": {"pak-sha256": {"$ref": "facts-v1.schema.json#/$defs/hash"}, "context": {"$ref": "#/$defs/context"}}
    }]},
    "rules": {"type": "array", "minItems": 1, "maxItems": 256, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "member-path", "object-identity", "class-identity", "class-default-flag", "path", "predicate", "expected", "action", "purpose", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/metadata"}, "member-path": {"$ref": "facts-v1.schema.json#/$defs/text"},
        "object-identity": {"$ref": "#/$defs/metadata"}, "class-identity": {"$ref": "#/$defs/metadata"}, "class-default-flag": {"type": "boolean"},
        "path": {"$ref": "facts-v1.schema.json#/$defs/data-path"}, "predicate": {"enum": ["changed", "equals", "not-equals"]},
        "expected": {"oneOf": [{"type": "null"}, {"$ref": "facts-v1.schema.json#/$defs/data-value"}]},
        "action": {"enum": ["review", "reject"]}, "purpose": {"$ref": "#/$defs/metadata"}, "provenance": {"$ref": "#/$defs/metadata"}
      },
      "allOf": [{"if": {"properties": {"predicate": {"const": "changed"}}}, "then": {"properties": {"expected": {"type": "null"}}}}]
    }}
  },
  "$defs": {
    "metadata": {"type": "string", "minLength": 1, "maxLength": 1024},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["engine-version", "build-scope", "content-root", "logical-root", "mapping-sha256", "mount-policy"],
      "properties": {"engine-version": {"const": "4.25"}, "build-scope": {"$ref": "#/$defs/metadata"},
        "content-root": {"$ref": "facts-v1.schema.json#/$defs/text"}, "logical-root": {"$ref": "facts-v1.schema.json#/$defs/text"},
        "mapping-sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "mount-policy": {"const": "submission-over-baseline"}}
    }
  }
}
